Plecs {
  Name          "Template_TI_RT_Box"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "0.15"
  Timeout       ""
  Solver        "auto"
  MaxStep       "1e-3"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "fblink = 2;\t\t\t\t\t% [Hz] LED blinking frequency\n"
"\n\n\n%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n% Inverter spec"
"ific\n\nf_sw \t\t= 20e3;  \t\t% [Hz]\tSwitching/Sampling frequency\ndeadtime "
"= 500e-9;\t\t% [s]\t\tBlanking time\n\n\nCPU2.fs     = f_sw;% [Hz]\t    Sampl"
"ing frequency\nCPU1.fs     = CPU2.fs;% [Hz] \nspi_nb_data     = 8;    % [-]  "
" Nb of 32 bit floats to sent (max 8)\nspi_clock       = 5e6;  % [Hz]  SPI clo"
"ck frequency\n\nRTbox.fspi  = CPU2.fs/20;\nRTbox.fbase = 4*CPU2.fs;        % "
"[Hz]      RT-Box CPU frequency\n   \n\n%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
"%%%%%%%%%%%%%%%%\n% RT Box Analog out\n\nRTboxAO.fullscale = 5;\t\t\t% [V]\t"
"\tRT box analog out full scale voltage\n\nRTboxAO.ADC_A.gain \t\t= 1;\nRTboxA"
"O.ADC_A.offset \t= 0;\nRTboxAO.ADC_B.gain \t\t= 1;\nRTboxAO.ADC_B.offset \t= "
"0\nRTboxAO.ADC_D.gain \t\t= 1;\nRTboxAO.ADC_D.offset \t= 0\n\n\n%%%%%%%%%%%%%"
"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n% TI ControlCARD ADC constants\n\n"
"ADC.fullscale = RTboxAO.fullscale * 0.65;\t% [V]\tADC full scale volage\nADC."
"t_acq = 200e-9; \t\t\t\t% [s]\tADC acquisition time (per channel)\n\nADC.A.ga"
"in \t\t= 1;\nADC.A.offset \t= 0;\nADC.B.gain \t\t= 1;\nADC.B.offset \t= 0;\nA"
"DC.D.gain \t\t= 1;\nADC.D.offset \t= 0;\n"
  InitialState  "1"
  SystemState   ""
  JacobianComputation "2"
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
