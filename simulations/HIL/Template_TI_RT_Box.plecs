"int i;\n"
"\n"
"for(i=0;i<NumInputSignals(0);i++)\n"
"\t{\n"
"\tbuffer.float_val = InputSignal(0,i);\n"
"\tOutputSignal(0,i) = buffer.uint_val;\n"
"\t}"
