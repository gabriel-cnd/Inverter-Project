.build/
build/

# Temporary LaTeX files
*.dvi
*.ps
*.upa
*.upb


# ============================================================
# KiCad
# ============================================================

# Automatic backups
*-backups/
_autosave-*
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*.sch-bak

# Lock files
~*.lck
