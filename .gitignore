*.kicad_sch.lck

# Local / cache files
*.kicad_prl
fp-info-cache

# Temporary editor files
*.tmp
*.swp
*~

# Router / intermediate files
*.dsn
*.ses


# ============================================================
# PLECS
# ============================================================

# Keep PLECS models (*.plecs) tracked.
# Ignore common backup / temporary files only.

*.plecs~
*.plecs.bak
*.plecs.autosave

# Generated simulation / compilation directories
plecs_codegen/
codegen/
generated/


# ============================================================
# Firmware / Embedded development
# ============================================================

# Compilation outputs
Debug/
Release/
debug/
release/

*.o
*.obj
*.a
*.lib
*.elf
*.hex
*.bin

# Dependency / intermediate files
*.d
*.dep

# Linker / listing outputs
*.lst

# Generated dependency folders
.deps/

